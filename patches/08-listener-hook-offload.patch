+// ---------------------------------------------------------------------------
+// Async stdout writer.
+// A WH_KEYBOARD_LL callback that runs longer than LowLevelHooksTimeout (1000 ms
+// by default) is SILENTLY removed by Windows — the process keeps running but the
+// hotkey stops working until restart. Doing printf()/fflush() inside the callback
+// risks exactly that: if the parent (Node) is momentarily busy and the stdout
+// pipe fills, fflush() blocks. So the hook only enqueues an event code here and a
+// dedicated thread performs the blocking write. The hook never touches stdout.
+// ---------------------------------------------------------------------------
+#define KL_QCAP 1024
+static int g_klQueue[KL_QCAP];
+static int g_klHead = 0;   // written by the hook (producer)
+static int g_klTail = 0;   // read by the writer thread (consumer)
+static CRITICAL_SECTION g_klCs;
+static HANDLE g_klEvt = NULL;   // auto-reset: signalled on each enqueue
+static volatile LONG g_klRunning = 1;
+
+// Called from the hook. The critical section is held only for the few
+// instructions it takes to push one int — never across any I/O — so the hook
+// callback returns well within the timeout regardless of pipe backpressure.
+static void KlEmit(int code) {
+    EnterCriticalSection(&g_klCs);
+    int next = (g_klHead + 1) % KL_QCAP;
+    if (next != g_klTail) {          // drop only if the ring is full (never in practice)
+        g_klQueue[g_klHead] = code;
+        g_klHead = next;
+    }
+    LeaveCriticalSection(&g_klCs);
+    if (g_klEvt) SetEvent(g_klEvt);
+}
+
+// Consumer thread: drains the ring and does the blocking printf/fflush here,
+// off the hook/message thread. 1 = KEY_DOWN, 2 = KEY_UP.
+static DWORD WINAPI KlWriterThread(LPVOID unused) {
+    (void)unused;
+    while (g_klRunning) {
+        WaitForSingleObject(g_klEvt, 200);   // event, or 200 ms poll so the thread can exit
+        for (;;) {
+            int code = 0;
+            EnterCriticalSection(&g_klCs);
+            if (g_klTail != g_klHead) {
+                code = g_klQueue[g_klTail];
+                g_klTail = (g_klTail + 1) % KL_QCAP;
+            }
+            LeaveCriticalSection(&g_klCs);
+            if (code == 0) break;            // ring drained
+            printf(code == 1 ? "KEY_DOWN\n" : "KEY_UP\n");
+            fflush(stdout);
+        }
+    }
+    return 0;
+}
