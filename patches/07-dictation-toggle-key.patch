@@ -1079,6 +1124,37 @@ async function startApp() {
         windowsKeyManager.start(hotkey);
       }
     });
+
+    // Second, independent dictation trigger: a latch/toggle key (e.g. Control+Alt)
+    // that starts recording on first press and stops it on the next press, no matter
+    // what activation mode the primary hotkey uses. Off unless DICTATION_TOGGLE_KEY set.
+    windowsToggleKeyManager.on("key-down", () => {
+      if (!isLiveWindow(windowManager.mainWindow)) return;
+      if (textEditMonitor) textEditMonitor.captureTargetPid();
+      windowManager.sendToggleDictation();
+    });
+    windowsToggleKeyManager.on("unavailable", () => {
+      debugLogger.warn(
+        "[Push-to-Talk] toggle-key listener unavailable (native binary missing)"
+      );
+    });
+
+    const startWindowsToggleListener = () => {
+      if (!isLiveWindow(windowManager.mainWindow)) return;
+      const toggleKey = environmentManager.getDictationToggleKey?.() || "";
+      if (toggleKey) {
+        windowsToggleKeyManager.start(toggleKey);
+      }
+    };
+    setTimeout(startWindowsToggleListener, STARTUP_DELAY_MS);
+
+    ipcMain.on("dictation-toggle-key-changed", (_event, toggleKey) => {
+      if (!isLiveWindow(windowManager.mainWindow)) return;
+      windowsToggleKeyManager.stop();
+      if (toggleKey) {
+        windowsToggleKeyManager.start(toggleKey);
+      }
+    });
   }
 
   if (process.platform === "linux") {
@@ -1323,6 +1399,9 @@ if (gotSingleInstanceLock) {
     if (windowsKeyManager) {
       windowsKeyManager.stop();
     }
+    if (windowsToggleKeyManager) {
+      windowsToggleKeyManager.stop();
+    }
     if (linuxKeyManager) {
       linuxKeyManager.stop();
     }
